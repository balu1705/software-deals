/* ============================================================
   Software-Deals — Design System
   0 € Budget | Static HTML/CSS | Apple-ähnliches Design
   ============================================================ */

/* ---------- Fonts (System-Fonts, kein Netz-Zugriff nötig) ---------- */
:root {
  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-mono: "SF Mono", "Fira Code", "Consolas", "Menlo", monospace;

  /* Farben */
  --bg-body: #fafafa;
  --bg-card: #ffffff;
  --bg-card-hover: #f6f6f6;
  --bg-nav: #ffffff;
  --bg-footer: #111111;
  --bg-btn: #111111;
  --bg-btn-hover: #333333;
  --bg-input: #ffffff;

  --text-primary: #111111;
  --text-secondary: #555555;
  --text-muted: #999999;
  --text-link: #0066cc;
  --text-link-hover: #0052a3;

  --accent: #0066cc;
  --accent-soft: #e8f1fc;
  --accent-border: #d0e2f7;

  --success: #1a7f37;
  --success-soft: #e6f4ea;
  --warning: #9a6700;
  --warning-soft: #fff8e1;
  --error: #b02a37;
  --error-soft: #fdeaea;

  --border: #e0e0e0;
  --border-strong: #cccccc;

  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.08);
  --shadow-btn: 0 2px 6px rgba(0, 0, 0, 0.12);

  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-full: 9999px;

  --max-width: 1120px;
  --gap: 16px;
  --gap-sm: 12px;

  --top-nav-height: 60px;
  --transition: 150ms ease;
}

/* ---------- Reset ---------- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.6;
  color: var(--text-primary);
  background: var(--bg-body);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

a {
  color: var(--text-link);
  text-decoration: none;
  transition: color var(--transition);
}

a:hover {
  color: var(--text-link-hover);
}

ul {
  list-style: none;
}

button {
  font-family: var(--font-sans);
  cursor: pointer;
  border: none;
  background: none;
  color: inherit;
}

/* ---------- Layout ---------- */
.container {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 var(--gap);
}

.page {
  padding-top: var(--top-nav-height);
}

/* ---------- Header / Navigation ---------- */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--bg-nav);
  border-bottom: 1px solid var(--border);
  backdrop-filter: saturate(180%) blur(12px);
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--top-nav-height);
  gap: var(--gap);
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -0.3px;
  color: var(--text-primary);
}

.brand-mark {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-sm);
  background: var(--text-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 0;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: var(--gap);
}

.nav-links a {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-secondary);
}

.nav-links a:hover {
  color: var(--text-primary);
}

.menu-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  padding: 8px;
  border-radius: var(--radius-sm);
  background: var(--bg-card);
  border: 1px solid var(--border);
}

.menu-toggle span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--text-primary);
  border-radius: 2px;
  transition: var(--transition);
}

/* ---------- Hero ---------- */
.hero {
  padding: 48px 0 40px;
  background: linear-gradient(180deg, #fafafa 0%, #ffffff 100%);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: var(--gap);
  align-items: center;
}

.hero h1 {
  font-size: 38px;
  line-height: 1.15;
  letter-spacing: -1.2px;
  margin-bottom: 16px;
  color: var(--text-primary);
}

.hero p {
  font-size: 17px;
  color: var(--text-secondary);
  margin-bottom: 24px;
}

.hero-actions {
  display: flex;
  gap: var(--gap);
  flex-wrap: wrap;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 20px;
  border-radius: var(--radius-md);
  font-size: 15px;
  font-weight: 600;
  transition: background var(--transition), box-shadow var(--transition);
}

.btn-primary {
  background: var(--bg-btn);
  color: #fff;
}

.btn-primary:hover {
  background: var(--text-primary);
  box-shadow: var(--shadow-btn);
}

.btn-outline {
  background: transparent;
  border: 1.5px solid var(--border-strong);
  color: var(--text-primary);
}

.btn-outline:hover {
  border-color: var(--text-primary);
  background: var(--bg-card-hover);
}

.btn-sm {
  padding: 8px 14px;
  font-size: 14px;
  border-radius: var(--radius-sm);
}

/* ---------- Card Grid ---------- */
.grid {
  display: grid;
  gap: var(--gap);
}

.grid-3 {
  grid-template-columns: repeat(3, 1fr);
}

.grid-2 {
  grid-template-columns: repeat(2, 1fr);
}

/* ---------- Category Card ---------- */
.category-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px;
  transition: box-shadow var(--transition), border-color var(--transition);
}

.category-card:hover {
  box-shadow: var(--shadow-md);
  border-color: var(--accent-border);
}

.category-card h2 {
  font-size: 22px;
  letter-spacing: -0.6px;
  margin-bottom: 8px;
}

.category-card .sub {
  font-size: 14px;
  color: var(--text-secondary);
  margin-bottom: 16px;
}

.category-card .badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  font-size: 12px;
  font-weight: 600;
  background: var(--accent-soft);
  color: var(--accent);
  margin-bottom: 12px;
}

.category-card .card-link {
  display: flex;
  align-items: center;
  gap: 10px;
}

/* ---------- Product Grid ---------- */
.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: var(--gap-sm);
}

.product-card {
  display: flex;
  flex-direction: column;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 16px;
  transition: box-shadow var(--transition), transform var(--transition);
}

.product-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-1px);
}

.product-card .p-image {
  width: 100%;
  aspect-ratio: 16/9;
  border-radius: var(--radius-sm);
  background: var(--bg-card-hover);
  overflow: hidden;
  margin-bottom: 12px;
}

.product-card .p-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-card h3 {
  font-size: 17px;
  letter-spacing: -0.4px;
  margin-bottom: 4px;
}

.product-card .p-compare {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 8px;
}

.product-card .p-compare span {
  font-size: 11px;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: var(--radius-full);
}

.product-card .p-price {
  font-size: 20px;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 8px;
}

.product-card .p-desc {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.5;
  flex-grow: 1;
}

.product-card .p-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--border);
}

.product-card .p-row a {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-link);
}

/* ---------- Deal Badge ---------- */
.deal-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--success-soft);
  color: var(--success);
  font-size: 12px;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: var(--radius-full);
  margin-bottom: 8px;
}

/* ---------- FAQ ---------- */
.faq {
  max-width: 820px;
  margin: 0 auto;
}

.faq-item {
  border-bottom: 1px solid var(--border);
}

.faq-item .q {
  font-size: 17px;
  font-weight: 600;
  padding: 18px 0;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.faq-item .q .icon {
  transition: transform var(--transition);
  color: var(--text-muted);
}

.faq-item.open .q .icon {
  transform: rotate(45deg);
}

.faq-item .a {
  color: var(--text-secondary);
  font-size: 15px;
  padding: 0 0 16px;
  max-height: 0;
  overflow: hidden;
  transition: max-height 200ms ease;
}

.faq-item.open .a {
  max-height: 300px;
}

/* ---------- Podcast / Magazine ---------- */
.podcast-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: var(--gap-sm);
}

.podcast-item {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 16px;
}

.podcast-item .p-status {
  font-size: 12px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: var(--radius-full);
  background: var(--success-soft);
  color: var(--success);
  margin-bottom: 8px;
}

.podcast-item h3 {
  font-size: 16px;
  letter-spacing: -0.4px;
  margin-bottom: 6px;
}

.podcast-item .p-info {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ---------- Newsletter ---------- */
.newsletter {
  padding: 48px 0;
  background: var(--bg-card);
  border-top: 1px solid var(--border);
}

.newsletter h2 {
  font-size: 26px;
  letter-spacing: -0.8px;
  margin-bottom: 8px;
}

.newsletter p {
  color: var(--text-secondary);
  font-size: 16px;
  margin-bottom: 20px;
}

.newsletter-form {
  display: flex;
  gap: var(--gap);
}

.newsletter-form input {
  flex: 1;
  min-width: 200px;
  padding: 12px 16px;
  border: 1.5px solid var(--border-strong);
  border-radius: var(--radius-md);
  font-size: 15px;
  font-family: var(--font-sans);
  outline: none;
  transition: border-color var(--transition);
}

.newsletter-form input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}

/* ---------- Footer ---------- */
.site-footer {
  background: var(--bg-footer);
  color: #ffffff;
  padding: 40px 0;
  margin-top: 40px;
}

.footer-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--gap);
  margin-bottom: 24px;
}

.footer-brand {
  font-size: 18px;
  font-weight: 700;
  margin-bottom: 8px;
}

.footer-col h4 {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.footer-col a {
  display: block;
  font-size: 14px;
  color: #aaaaaa;
  padding: 4px 0;
  transition: color var(--transition);
}

.footer-col a:hover {
  color: #ffffff;
}

.footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  padding-top: 20px;
  text-align: center;
  font-size: 13px;
  color: #888888;
}

/* ---------- Utility ---------- */
.mt-1 { margin-top: 8px; }
.mt-2 { margin-top: 16px; }
.mt-3 { margin-top: 24px; }
.mt-4 { margin-top: 40px; }

.mb-1 { margin-bottom: 8px; }
.mb-2 { margin-bottom: 16px; }
.mb-3 { margin-bottom: 24px; }
.mb-4 { margin-bottom: 40px; }

.text-center { text-align: center; }
.text-muted { color: var(--text-muted); }
.text-soft { color: var(--text-secondary); }

.badge-t1 {
  background: var(--success-soft);
  color: var(--success);
}
.badge-t2 {
  background: var(--warning-soft);
  color: var(--warning);
}
.badge-t3 {
  background: var(--border);
  color: var(--text-muted);
}

/* ---------- Responsive ---------- */
@media (max-width: 900px) {
  .hero-grid {
    grid-template-columns: 1fr;
  }

  .hero h1 {
    font-size: 30px;
  }

  .grid-3,
  .grid-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  body {
    font-size: 15px;
  }

  .hero {
    padding: 32px 0 28px;
  }

  .hero h1 {
    font-size: 26px;
  }

  .hero p {
    font-size: 16px;
  }

  .nav-links {
    display: none;
    position: absolute;
    top: var(--top-nav-height);
    left: 0;
    right: 0;
    background: var(--bg-nav);
    border-bottom: 1px solid var(--border);
    padding: var(--gap);
    gap: var(--gap);
  }

  .nav-links.open {
    display: flex;
  }

  .menu-toggle {
    display: flex;
  }

  .grid-3,
  .grid-2,
  .podcast-grid {
    grid-template-columns: 1fr;
  }

  .footer-grid {
    grid-template-columns: 1fr;
  }

  .newsletter-form {
    flex-direction: column;
  }

  .newsletter-form input {
    min-width: auto;
  }
}
